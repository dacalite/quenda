{
  "name": "quenda",
  "private": true,
  "version": "0.0.0",
  "description": "Prototipo de plataforma de reserva de instalacións deportivas municipais",
  "license": "EUPL-1.2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint . && prettier --check --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .prettierignore.local . && node scripts/check-spdx.mjs",
    "format": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .prettierignore.local .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "licenses": "license-checker-rseidelsohn --excludePrivatePackages --excludePackages \"caniuse-lite;spdx-exceptions;spdx-ranges\" --onlyAllow \"MIT;MIT-0;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;MPL-2.0;BlueOak-1.0.0;OFL-1.1;CC0-1.0;EUPL-1.2\""
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "i18next": "^26.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
